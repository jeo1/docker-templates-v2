COMPOSE_PROJECT_NAME=mariadb
TIMEZONE=America/Toronto

MARIADB_CONTAINER_NAME={{ CONTAINER_NAME | default("mariadb") }}
GATEWAY_CONTAINER_NAME={{ CONTAINER_NAME | default("mariadb-gateway") }}

DATA={{ DATA | default("./data") }}
SQL_PORT={{ SQL_PORT | default("3306") }}
HTTP_PORT={{ HTTP_PORT | default("8080") }}

MARIADB_ROOT_PASSWORD={{ MARIADB_ROOT_PASSWORD }}
MARIADB_DATABASE={{ MARIADB_DATABASE | default("database") }}
MARIADB_USER={{ MARIADB_USER | default("user") }}
MARIADB_PASSWORD={{ MARIADB_PASSWORD}}
API_TOKEN={{ API_TOKEN }}
