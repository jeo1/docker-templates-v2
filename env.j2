COMPOSE_PROJECT_NAME=chaptarr
TIMEZONE=America/Toronto

CHAPTARR_CONTAINER_NAME={{ CHAPTARR_CONTAINER_NAME | default("chaptarr") }}

EXTERNAL_CHAPTARR_PORT={{ EXTERNAL_CHAPTARR_PORT | default("8789") }}

CHAPTARR_CONFIG={{ CHAPTARR_CONFIG | default("/home/config/chaptarr/config") }}
CHAPTARR_AUDIOBOOKS={{ CHAPTARR_AUDIOBOOKS | default("/home/config/chaptarr/audiobooks") }}
CHAPTARR_EBOOKS={{ CHAPTARR_EBOOKS | default("/home/config/chaptarr/ebooks") }}
CHAPTARR_DOWNLOADS={{ CHAPTARR_DOWNLOADS | default("/home/config/chaptarr/downloads") }}
